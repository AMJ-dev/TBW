RewriteRule ^admin/config/integrations/$ src/admin-config/integrations.php [NC]
RewriteRule ^admin/config/integrations/update/$ src/admin-config/update-integrations.php [NC]
RewriteRule ^admin/config/security/$ src/admin-config/security.php [NC]
RewriteRule ^admin/config/security/update/$ src/admin-config/update-security.php [NC]

