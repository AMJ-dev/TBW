RewriteRule ^vehicles/my-orgs/$ src/vehicles/my-orgs.php [NC]
RewriteRule ^vehicles/search/$ src/vehicles/search.php [NC]
RewriteRule ^vehicles/reject/$ src/vehicles/reject.php [NC]
