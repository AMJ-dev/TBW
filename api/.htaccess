RewriteEngine On

# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
 
Options -Indexes

RewriteCond %{REQUEST_URI} /+[^\.]+$ 
RewriteRule ^(.+[^/])$ %{REQUEST_URI}/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

RewriteRule ^get-home/$ src/get-home.php [NC]
RewriteRule ^contact-us/$ src/contact-us.php [NC]
RewriteRule ^sign-in/$ src/sign-in.php [NC]
RewriteRule ^sign-up/$ src/sign-up.php [NC]
RewriteRule ^otp/$ src/otp.php [NC]
RewriteRule ^inquires/$ src/inquires.php [NC]
RewriteRule ^subscribe/$ src/subscribe.php [NC]
RewriteRule ^resend-otp/$ src/resend-otp.php [NC]
RewriteRule ^resend-password/$ src/resend-password.php [NC]
RewriteRule ^reset-password/$ src/reset-password.php [NC]
RewriteRule ^get-dashboard/$ src/get-dashboard.php [NC]
RewriteRule ^get-profile/$ src/get-profile.php [NC]
RewriteRule ^change-password/$ src/change-password.php [NC]

RewriteRule ^add-news/$ src/news/add.php [NC]
RewriteRule ^update-news/$ src/news/update.php [NC]
RewriteRule ^delete-news/$ src/news/delete.php [NC]
RewriteRule ^get-news/$ src/news/all.php [NC]
RewriteRule ^news/([0-9]+)/$ src/news/single.php?id=$1 [NC]
RewriteRule ^related-news/([0-9]+)/$ src/news/related.php?id=$1 [NC]

RewriteRule ^add-faq/$ src/faq/add.php [NC]
RewriteRule ^update-faq/$ src/faq/update.php [NC]
RewriteRule ^delete-faq/$ src/faq/delete.php [NC]
RewriteRule ^get-faqs/$ src/faq/all.php [NC]
RewriteRule ^faq/([0-9]+)/$ src/faq/single.php?id=$1 [NC]
